# ── Production Docker (/opt/fastbag/.env sur le VPS) ──
# Données hors dépôt : bind mount /opt/fastbag-data → /data

DATABASE_URL="file:/data/db/prod.db"
UPLOAD_DIR="/data/uploads"

# Hash bcrypt du mot de passe unique (jamais "changeme" en prod)
# Générer sur le VPS (après clone) :
#   cd /opt/fastbag && docker run --rm -v "$PWD":/app -w /app node:20-bookworm-slim \
#     node -e "require('bcryptjs').hash('TON_MOT_DE_PASSE',10).then(console.log)"
# Puis échapper chaque $ dans .env :
#   APP_PASSWORD_HASH=\$2b\$10\$...
APP_PASSWORD_HASH=\$2b\$10\$remplace.par.ton.hash.bcrypt................

# Secret de signature du cookie (long et aléatoire)
# Générer : openssl rand -base64 48
SESSION_SECRET="remplace-par-une-chaine-longue-aleatoire"

NEXT_PUBLIC_APP_URL="https://stock.sitereadyshd.fr"
NODE_ENV="production"
PORT=3000
HOSTNAME=0.0.0.0

# ── Dev local (hors Docker) — exemple ──
# DATABASE_URL="file:../data/db/dev.db"
# UPLOAD_DIR="./data/uploads"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
