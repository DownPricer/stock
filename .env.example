# URL SQLite absolue ou relative au dossier prisma/
# Prod recommandé : hors du dépôt git
DATABASE_URL="file:/var/www/stock-data/db/prod.db"

# Dossier des photos (hors dépôt)
UPLOAD_DIR="/var/www/stock-data/uploads"

# Hash bcrypt du mot de passe unique
# Générer avec :
#   node -e "require('bcryptjs').hash('TON_MOT_DE_PASSE',10).then(console.log)"
# Échapper chaque $ (Next.js utilise dotenv-expand) :
# APP_PASSWORD_HASH=\$2b\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_PASSWORD_HASH=\$2b\$10\$remplace.par.ton.hash.bcrypt................

# Secret de signature du cookie de session (long et aléatoire)
# Générer avec : openssl rand -base64 48
SESSION_SECRET="remplace-par-une-chaine-longue-aleatoire"

# URL publique de l'app
NEXT_PUBLIC_APP_URL="https://stock.sitereadyshd.fr"

# Port d'écoute Next (doit être libre sur le VPS)
PORT=3007

NODE_ENV="production"
