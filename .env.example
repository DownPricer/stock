# ── Production Docker (/opt/fastbag/.env sur le VPS, lu via env_file) ──
# Données hors dépôt : bind mount /opt/fastbag-data → /data
#
# Avec Docker Compose (env_file), NE PAS échapper les $. Utiliser des
# apostrophes simples :
#   APP_PASSWORD_HASH='$2b$10$...'
# L'échappement \$ (APP_PASSWORD_HASH=\$2b\$10\$...) ne vaut QUE pour un
# .env local lu par Next.js (dotenv-expand). Sur le VPS Docker, ça casse
# le hash (ex. "\$2b\$10\").

DATABASE_URL="file:/data/db/prod.db"
UPLOAD_DIR="/data/uploads"

# Hash bcrypt — générer sur ton PC (dans le dossier du projet) :
#   node -e "require('bcryptjs').hash(process.argv[1],10).then(console.log)" "TON_MOT_DE_PASSE"
# Puis coller le résultat entre apostrophes simples (VPS / Docker) :
APP_PASSWORD_HASH='$2b$10$remplace.par.ton.hash.bcrypt................'

# Secret de signature du cookie (long et aléatoire)
# Générer : openssl rand -base64 48
SESSION_SECRET="remplace-par-une-chaine-longue-aleatoire"

NEXT_PUBLIC_APP_URL="https://stock.sitereadyshd.fr"
NODE_ENV="production"
PORT=3000
HOSTNAME=0.0.0.0

# ── Dev local (hors Docker, lu par Next) — exemple ──
# DATABASE_URL="file:../data/db/dev.db"
# UPLOAD_DIR="./data/uploads"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Ici seulement, échapper les $ du hash :
# APP_PASSWORD_HASH=\$2b\$10\$...
